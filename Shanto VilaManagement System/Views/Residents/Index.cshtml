@model Shanto_VilaManagement_System.ViewModels.ResidentsIndexViewModel
@{
    ViewData["Title"] = "বাসিন্দা ও ভাড়াটিয়া তালিকা";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h1 class="h3 fw-bold text-dark mb-1">
            <i class="bi bi-people-fill text-primary me-2"></i>বাসিন্দা ও ভাড়াটিয়া তালিকা
        </h1>
        <p class="text-secondary mb-0 small">
            রুম ভিত্তিক প্রধান ভাড়াটিয়া ও সকল সদস্যদের পরিচালনা এবং প্রস্থান ব্যবস্থাপনা
        </p>
    </div>

    <div class="d-flex flex-wrap gap-2 align-items-center">
        <!-- Room Filter -->
        <form method="get" class="d-flex align-items-center gap-2">
            <input type="hidden" name="tab" value="@Model.ActiveTab" />
            <select name="roomId" class="form-select form-select-sm" onchange="this.form.submit()" style="min-width: 170px;">
                <option value="">— সকল রুম —</option>
                @foreach (var r in Model.AllRooms)
                {
                    if (Model.SelectedRoomId == r.Id)
                    {
                        <option value="@r.Id" selected>রুম @BanglaHelper.ToBanglaDigits(r.RoomNumber)</option>
                    }
                    else
                    {
                        <option value="@r.Id">রুম @BanglaHelper.ToBanglaDigits(r.RoomNumber)</option>
                    }
                }
            </select>
            @if (Model.SelectedRoomId.HasValue)
            {
                <a asp-action="Index" asp-route-tab="@Model.ActiveTab" class="btn btn-sm btn-outline-custom" title="ফিল্টার মুছুন">
                    <i class="bi bi-x-circle"></i>
                </a>
            }
        </form>

        <a asp-action="Create" asp-route-roomId="@Model.SelectedRoomId" class="btn btn-primary-custom">
            <i class="bi bi-person-plus-fill"></i> নতুন ভাড়াটিয়া যুক্ত করুন
        </a>
    </div>
</div>

<!-- Navigation Tabs -->
<ul class="nav nav-pills mb-4 gap-2">
    <li class="nav-item">
        <a class="nav-link @(Model.ActiveTab == "active" ? "active bg-primary text-white fw-bold shadow-sm" : "bg-light text-dark border")" 
           asp-action="Index" asp-route-tab="active" asp-route-roomId="@Model.SelectedRoomId">
            <i class="bi bi-house-door-fill me-1"></i> বর্তমান বাসিন্দা (রুম ভিত্তিক)
            <span class="badge @(Model.ActiveTab == "active" ? "bg-white text-primary" : "bg-primary text-white") ms-2">
                @BanglaHelper.ToBanglaDigits(Model.TotalActiveResidentsCount) জন
            </span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.ActiveTab == "archived" ? "active bg-primary text-white fw-bold shadow-sm" : "bg-light text-dark border")" 
           asp-action="Index" asp-route-tab="archived" asp-route-roomId="@Model.SelectedRoomId">
            <i class="bi bi-archive-fill me-1"></i> প্রাক্তন / রুম ছেড়ে যাওয়া বাসিন্দা (আর্কাইভ)
            <span class="badge @(Model.ActiveTab == "archived" ? "bg-white text-primary" : "bg-secondary text-white") ms-2">
                @BanglaHelper.ToBanglaDigits(Model.TotalArchivedResidentsCount) জন
            </span>
        </a>
    </li>
</ul>

@if (Model.ActiveTab == "active")
{
    <!-- TAB 1: ACTIVE RESIDENTS (ROOM-WISE PRIMARY TENANT & ACCORDION) -->
    <div class="custom-card">
        <div class="card-header-custom d-flex justify-content-between align-items-center">
            <h2 class="card-title-custom">
                <i class="bi bi-building text-primary"></i>
                <span>রুম ভিত্তিক বাসিন্দা তালিকা (@BanglaHelper.ToBanglaDigits(Model.RoomGroups.Count) টি রুমে ভাড়াটিয়া আছেন)</span>
            </h2>
            <span class="text-muted small">
                <i class="bi bi-info-circle me-1"></i>"সকল সদস্য দেখুন" বাটনে ক্লিক করে সংশ্লিষ্ট রুমের সকল সদস্য দেখা, এডিট বা প্রস্থান (সফ্ট ডিলিট) করা যাবে
            </span>
        </div>

        <div class="card-body-custom p-0">
            <!-- Desktop Table View -->
            <div class="table-responsive d-none d-md-block">
                <table class="table-custom align-middle">
                    <thead>
                        <tr>
                            <th style="width: 110px;">রুম নম্বর</th>
                            <th style="width: 70px;">ছবি</th>
                            <th>প্রধান ভাড়াটিয়ার নাম</th>
                            <th>মোট সদস্য সংখ্যা</th>
                            <th>মোবাইল নম্বর</th>
                            <th>পেশা ও প্রতিষ্ঠান</th>
                            <th>মাসিক রুম ভাড়া</th>
                            <th class="text-end" style="min-width: 250px;">একশন</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.RoomGroups.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5 text-muted">
                                    <i class="bi bi-people fs-1 d-block mb-2 text-secondary"></i>
                                    বর্তমানে কোনো সক্রিয় ভাড়াটিয়া বা বাসিন্দা পাওয়া যায়নি।
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var group in Model.RoomGroups)
                            {
                                var primary = group.PrimaryTenant;
                                var collapseId = $"collapseRoom_{group.Room.Id}";
                                
                                <tr class="room-main-row" id="roomRow_@group.Room.Id">
                                    <td>
                                        <a asp-controller="Rooms" asp-action="Details" asp-route-id="@group.Room.Id" 
                                           class="fw-bold text-primary text-decoration-none fs-6">
                                            রুম @BanglaHelper.ToBanglaDigits(group.Room.RoomNumber)
                                        </a>
                                        @if (!string.IsNullOrWhiteSpace(group.Room.MeterNumber))
                                        {
                                            <div class="text-muted small" style="font-size: 0.75rem;">
                                                মিটার: @group.Room.MeterNumber
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(primary?.Photo))
                                        {
                                            <img src="@primary.Photo" alt="@primary.Name" class="resident-avatar" style="width: 44px; height: 44px;" />
                                        }
                                        else
                                        {
                                            <div class="resident-avatar d-flex align-items-center justify-content-center bg-light text-secondary" 
                                                 style="width: 44px; height: 44px; border-radius: 50%;">
                                                <i class="bi bi-person fs-4"></i>
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        @if (primary != null)
                                        {
                                            <a asp-action="Details" asp-route-id="@primary.Id" class="fw-bold text-dark text-decoration-none fs-6">
                                                @primary.Name
                                            </a>
                                            <div>
                                                <span class="badge bg-primary" style="font-size: 0.65rem;">
                                                    <i class="bi bi-star-fill me-1"></i>প্রধান ভাড়াটিয়া
                                                </span>
                                                @if (primary.AdvanceAmount > 0)
                                                {
                                                    <span class="badge bg-success ms-1" style="font-size: 0.65rem;" title="অগ্রিম টাকা">
                                                        অগ্রিম: @BanglaHelper.ToBanglaCurrency(primary.AdvanceAmount)
                                                    </span>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">অনির্ধারিত</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-info text-dark border fs-6 px-3 py-1">
                                            <i class="bi bi-people-fill me-1"></i>@BanglaHelper.ToBanglaDigits(group.TotalActiveCount) জন
                                        </span>
                                        <div class="text-muted small mt-1" style="font-size: 0.75rem;">
                                            প্রাপ্তবয়স্ক: @BanglaHelper.ToBanglaDigits(group.AdultCount), শিশু: @BanglaHelper.ToBanglaDigits(group.ChildCount)
                                        </div>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(primary?.Phone))
                                        {
                                            <a href="tel:@primary.Phone" class="text-decoration-none text-dark fw-semibold">
                                                <i class="bi bi-telephone text-primary me-1"></i>@primary.Phone
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark">@(primary?.Profession ?? "—")</div>
                                        <div class="small text-muted">@(primary?.Organization ?? "")</div>
                                    </td>
                                    <td class="fw-bold text-dark">
                                        @BanglaHelper.ToBanglaCurrency(group.Room.RoomRent)
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <!-- View All Members Toggle Button -->
                                            <button type="button" class="btn btn-outline-primary fw-semibold" 
                                                    data-bs-toggle="collapse" data-bs-target="#@collapseId" 
                                                    aria-expanded="false" aria-controls="@collapseId"
                                                    title="এই রুমের সকল সদস্য দেখুন">
                                                <i class="bi bi-chevron-down me-1"></i> সকল সদস্য (@BanglaHelper.ToBanglaDigits(group.TotalActiveCount))
                                            </button>

                                            <!-- Vacate Room / Soft Delete All Button -->
                                            <button type="button" class="btn btn-outline-danger" 
                                                    onclick="confirmVacateRoom(@group.Room.Id, '@group.Room.RoomNumber', @group.TotalActiveCount)"
                                                    title="এই রুমের সকল বাসিন্দা চলে গেছেন (রুম খালি করুন)">
                                                <i class="bi bi-door-closed"></i> রুম খালি করুন
                                            </button>
                                        </div>
                                    </td>
                                </tr>

                                <!-- ACCORDION COLLAPSIBLE DRAWER FOR ALL MEMBERS OF THIS ROOM -->
                                <tr class="collapse-row p-0">
                                    <td colspan="8" class="p-0 border-0">
                                        <div class="collapse" id="@collapseId">
                                            <div class="p-3 bg-light border-top border-bottom">
                                                <div class="d-flex justify-content-between align-items-center mb-2 px-2">
                                                    <h6 class="fw-bold text-dark mb-0">
                                                        <i class="bi bi-people text-primary me-2"></i>
                                                        রুম @BanglaHelper.ToBanglaDigits(group.Room.RoomNumber)-এর সকল সদস্যের তালিকা (@BanglaHelper.ToBanglaDigits(group.TotalActiveCount) জন)
                                                    </h6>
                                                    <a asp-action="Create" asp-route-roomId="@group.Room.Id" asp-route-isAddMember="true" class="btn btn-sm btn-outline-primary">
                                                        <i class="bi bi-person-plus-fill me-1"></i>এই রুমে আরো সদস্য যোগ করুন
                                                    </a>
                                                </div>

                                                <div class="table-responsive bg-white rounded-3 border">
                                                    <table class="table table-hover align-middle mb-0 small">
                                                        <thead class="table-light">
                                                            <tr>
                                                                <th style="width: 50px;">ছবি</th>
                                                                <th>নাম</th>
                                                                <th>সম্পর্ক</th>
                                                                <th>বয়স / জন্মতারিখ</th>
                                                                <th>মোবাইল নম্বর</th>
                                                                <th>পেশা ও প্রতিষ্ঠান</th>
                                                                <th>NID ডকুমেন্ট</th>
                                                                <th class="text-end" style="width: 200px;">একশন</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var res in group.ActiveResidents)
                                                            {
                                                                <tr>
                                                                    <td>
                                                                        @if (!string.IsNullOrWhiteSpace(res.Photo))
                                                                        {
                                                                            <img src="@res.Photo" alt="@res.Name" class="resident-avatar" style="width: 36px; height: 36px;" />
                                                                        }
                                                                        else
                                                                        {
                                                                            <div class="resident-avatar d-flex align-items-center justify-content-center bg-light text-secondary" 
                                                                                 style="width: 36px; height: 36px; border-radius: 50%;">
                                                                                <i class="bi bi-person fs-5"></i>
                                                                            </div>
                                                                        }
                                                                    </td>
                                                                    <td>
                                                                        <a asp-action="Details" asp-route-id="@res.Id" class="fw-bold text-dark text-decoration-none">
                                                                            @res.Name
                                                                        </a>
                                                                        @if (res.IsPrimaryTenant)
                                                                        {
                                                                            <span class="badge bg-primary ms-1" style="font-size: 0.65rem;">প্রধান ভাড়াটিয়া</span>
                                                                        }
                                                                    </td>
                                                                    <td>
                                                                        <span class="badge bg-light text-dark border">@res.Relationship</span>
                                                                    </td>
                                                                    <td>
                                                                        @(res.DateOfBirthOrAge ?? "—")
                                                                    </td>
                                                                    <td>
                                                                        @if (!string.IsNullOrWhiteSpace(res.Phone) && res.Phone != "—")
                                                                        {
                                                                            <a href="tel:@res.Phone" class="text-decoration-none text-dark">
                                                                                @res.Phone
                                                                            </a>
                                                                        }
                                                                        else
                                                                        {
                                                                            <span class="text-muted">—</span>
                                                                        }
                                                                    </td>
                                                                    <td>
                                                                        <div>@(res.Profession ?? "—")</div>
                                                                        <div class="text-muted" style="font-size: 0.75rem;">@(res.Organization ?? "")</div>
                                                                    </td>
                                                                    <td>
                                                                        <div class="d-flex gap-1">
                                                                            @if (!string.IsNullOrWhiteSpace(res.NIDFront))
                                                                            {
                                                                                <a href="@res.NIDFront" target="_blank" class="badge bg-light text-primary border text-decoration-none" title="NID Front">
                                                                                    <i class="bi bi-card-image"></i> ফ্রন্ট
                                                                                </a>
                                                                            }
                                                                            @if (!string.IsNullOrWhiteSpace(res.NIDBack))
                                                                            {
                                                                                <a href="@res.NIDBack" target="_blank" class="badge bg-light text-primary border text-decoration-none" title="NID Back">
                                                                                    <i class="bi bi-card-image"></i> ব্যাক
                                                                                </a>
                                                                            }
                                                                            @if (string.IsNullOrWhiteSpace(res.NIDFront) && string.IsNullOrWhiteSpace(res.NIDBack))
                                                                            {
                                                                                <span class="text-muted">—</span>
                                                                            }
                                                                        </div>
                                                                    </td>
                                                                    <td class="text-end">
                                                                        <div class="btn-group btn-group-sm">
                                                                            <a asp-action="Details" asp-route-id="@res.Id" class="btn btn-light" title="বিস্তারিত দেখুন">
                                                                                <i class="bi bi-eye text-primary"></i>
                                                                            </a>
                                                                            <a asp-action="Edit" asp-route-id="@res.Id" class="btn btn-light" title="এডিট করুন">
                                                                                <i class="bi bi-pencil text-secondary"></i>
                                                                            </a>
                                                                            <!-- Single Member Soft Delete -->
                                                                            <button type="button" class="btn btn-light text-danger" 
                                                                                    onclick="confirmSoftDelete(@res.Id, '@res.Name', '@group.Room.RoomNumber')" 
                                                                                    title="এই সদস্য আর এ রুমে থাকেন না (প্রস্থান / সফ্ট ডিলিট)">
                                                                                <i class="bi bi-box-arrow-right"></i> প্রস্থান
                                                                            </button>
                                                                        </div>
                                                                    </td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <!-- Mobile Card View -->
            <div class="d-md-none p-3">
                @if (!Model.RoomGroups.Any())
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-people fs-1 d-block mb-2 text-secondary"></i>
                        বর্তমানে কোনো সক্রিয় ভাড়াটিয়া বা বাসিন্দা পাওয়া যায়নি।
                    </div>
                }
                else
                {
                    @foreach (var group in Model.RoomGroups)
                    {
                        var primary = group.PrimaryTenant;
                        var mobCollapseId = $"mobCollapseRoom_{group.Room.Id}";
                        <div class="mobile-data-card" id="mobRoomCard_@group.Room.Id">
                            <div class="d-flex justify-content-between align-items-start mb-2 pb-2 border-bottom">
                                <div>
                                    <a asp-controller="Rooms" asp-action="Details" asp-route-id="@group.Room.Id" 
                                       class="fw-bold text-primary text-decoration-none fs-6">
                                        রুম @BanglaHelper.ToBanglaDigits(group.Room.RoomNumber)
                                    </a>
                                    @if (!string.IsNullOrWhiteSpace(group.Room.MeterNumber))
                                    {
                                        <div class="text-muted small" style="font-size: 0.75rem;">
                                            মিটার: @group.Room.MeterNumber
                                        </div>
                                    }
                                </div>
                                <div class="text-end">
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                        ভাড়া: @BanglaHelper.ToBanglaCurrency(group.Room.RoomRent)
                                    </span>
                                </div>
                            </div>

                            <!-- Primary Resident Header info -->
                            <div class="d-flex align-items-center gap-2 mb-3">
                                @if (!string.IsNullOrWhiteSpace(primary?.Photo))
                                {
                                    <img src="@primary.Photo" alt="@primary.Name" class="resident-avatar" style="width: 46px; height: 46px; object-fit: cover; border-radius: 50%;" />
                                }
                                else
                                {
                                    <div class="resident-avatar d-flex align-items-center justify-content-center bg-light text-secondary" 
                                         style="width: 46px; height: 46px; border-radius: 50%;">
                                        <i class="bi bi-person fs-3"></i>
                                    </div>
                                }
                                <div class="flex-grow-1 min-w-0">
                                    @if (primary != null)
                                    {
                                        <div class="d-flex align-items-center flex-wrap gap-1">
                                            <a asp-action="Details" asp-route-id="@primary.Id" class="fw-bold text-dark text-decoration-none">
                                                @primary.Name
                                            </a>
                                            <span class="badge bg-primary" style="font-size: 0.65rem;">প্রধান ভাড়াটিয়া</span>
                                            @if (primary.AdvanceAmount > 0)
                                            {
                                                <span class="badge bg-success" style="font-size: 0.65rem;">
                                                    অগ্রিম: @BanglaHelper.ToBanglaCurrency(primary.AdvanceAmount)
                                                </span>
                                            }
                                        </div>
                                        <div class="small text-muted text-truncate">
                                            @(primary.Profession ?? "—") @(!string.IsNullOrWhiteSpace(primary.Organization) ? $"({primary.Organization})" : "")
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">অনির্ধারিত</span>
                                    }
                                </div>
                            </div>

                            <!-- Metrics Grid -->
                            <div class="card-metrics-grid mb-3">
                                <div class="metric-box">
                                    <span class="metric-label">মোট বাসিন্দা</span>
                                    <span class="metric-val text-primary">
                                        <i class="bi bi-people-fill me-1"></i>@BanglaHelper.ToBanglaDigits(group.TotalActiveCount) জন
                                    </span>
                                    <span class="text-muted" style="font-size: 0.7rem;">বড়: @BanglaHelper.ToBanglaDigits(group.AdultCount), শিশু: @BanglaHelper.ToBanglaDigits(group.ChildCount)</span>
                                </div>
                                <div class="metric-box">
                                    <span class="metric-label">মোবাইল নম্বর</span>
                                    <span class="metric-val">
                                        @if (!string.IsNullOrWhiteSpace(primary?.Phone))
                                        {
                                            <a href="tel:@primary.Phone" class="text-decoration-none text-primary fw-bold" style="font-size: 0.85rem;">
                                                <i class="bi bi-telephone-fill me-1"></i>@primary.Phone
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </span>
                                </div>
                            </div>

                            <!-- Action Buttons -->
                            <div class="d-flex gap-2 mb-2">
                                <button type="button" class="btn btn-sm btn-outline-primary flex-fill fw-semibold" 
                                        data-bs-toggle="collapse" data-bs-target="#@mobCollapseId" 
                                        aria-expanded="false" aria-controls="@mobCollapseId">
                                    <i class="bi bi-chevron-down me-1"></i> সদস্য তালিকা (@BanglaHelper.ToBanglaDigits(group.TotalActiveCount))
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger" 
                                        onclick="confirmVacateRoom(@group.Room.Id, '@group.Room.RoomNumber', @group.TotalActiveCount)">
                                    <i class="bi bi-door-closed"></i> রুম খালি
                                </button>
                            </div>

                            <!-- Collapsible drawer for room members on mobile -->
                            <div class="collapse mt-2" id="@mobCollapseId">
                                <div class="p-2 bg-light rounded-3 border">
                                    <div class="d-flex justify-content-between align-items-center mb-2 px-1">
                                        <span class="fw-bold small text-dark">
                                            সদস্যদের বিবরণ (@BanglaHelper.ToBanglaDigits(group.TotalActiveCount) জন)
                                        </span>
