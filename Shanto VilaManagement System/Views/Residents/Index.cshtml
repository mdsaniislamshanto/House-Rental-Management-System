<!-- MODAL: CONFIRM RESTORE ALL FOR A ROOM -->
<div class="modal fade" id="restoreRoomModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="RestoreRoom" method="post">
                <input type="hidden" name="roomId" id="restoreRoomId" />
                <div class="modal-header">
                    <h5 class="modal-title fw-bold text-success">
                        <i class="bi bi-arrow-counterclockwise text-success me-2"></i>রুমের সকল বাসিন্দা পুনর্বহাল
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">
                        আপনি কি <strong>রুম <span id="restoreRoomNo" class="text-primary"></span></strong>-এর মোট <span id="restoreRoomCount" class="fw-bold"></span> জন প্রাক্তন বাসিন্দাকে পুনরায় এই রুমে সক্রিয় বাসিন্দা হিসেবে পুনর্বহাল করতে চান?
                    </p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-custom" data-bs-dismiss="modal">বাতিল</button>
                    <button type="submit" class="btn btn-success fw-bold">
                        <i class="bi bi-check-circle me-1"></i>সকলকে সক্রিয় করুন
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmSoftDelete(id, name, roomNo) {
            document.getElementById('softDeleteResidentId').value = id;
            document.getElementById('softDeleteResidentName').textContent = name;
            document.getElementById('softDeleteRoomNumber').textContent = roomNo;
            const modal = new bootstrap.Modal(document.getElementById('softDeleteModal'));
            modal.show();
        }

        function confirmVacateRoom(roomId, roomNo, count) {
            document.getElementById('vacateRoomId').value = roomId;
            document.getElementById('vacateRoomNumber').textContent = roomNo;
            document.getElementById('vacateResidentCount').textContent = count;
            const modal = new bootstrap.Modal(document.getElementById('vacateRoomModal'));
            modal.show();
        }

        function confirmPermanentDelete(id, name) {
            document.getElementById('permanentDeleteResidentId').value = id;
            document.getElementById('permanentDeleteResidentName').textContent = name;
            const modal = new bootstrap.Modal(document.getElementById('permanentDeleteModal'));
            modal.show();
        }

        function confirmRestore(id, name, roomNo) {
            document.getElementById('restoreResidentId').value = id;
            document.getElementById('restoreResidentName').textContent = name;
            document.getElementById('restoreRoomNumber').textContent = roomNo;
            const modal = new bootstrap.Modal(document.getElementById('restoreModal'));
            modal.show();
        }

        function confirmPermanentDeleteRoom(roomId, roomNo, count) {
            document.getElementById('permanentDeleteRoomId').value = roomId;
            document.getElementById('permanentDeleteRoomNo').textContent = roomNo;
            document.getElementById('permanentDeleteRoomCount').textContent = count;
            const modal = new bootstrap.Modal(document.getElementById('permanentDeleteRoomModal'));
            modal.show();
        }

        function confirmRestoreRoom(roomId, roomNo, count) {
            document.getElementById('restoreRoomId').value = roomId;
            document.getElementById('restoreRoomNo').textContent = roomNo;
            document.getElementById('restoreRoomCount').textContent = count;
            const modal = new bootstrap.Modal(document.getElementById('restoreRoomModal'));
            modal.show();
        }
    </script>
}
