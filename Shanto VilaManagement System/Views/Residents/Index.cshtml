                            <div class="collapse mt-2" id="@mobArchiveCollapseId">
                                <div class="p-2 bg-light rounded-3 border">
                                    <span class="fw-bold small text-dark d-block mb-2 px-1">
                                        রুমের প্রাক্তন সদস্যবৃন্দ (@BanglaHelper.ToBanglaDigits(group.TotalCount) জন)
                                    </span>
                                    @foreach (var res in group.ArchivedResidents)
                                    {
                                        <div class="bg-white rounded-2 p-2 mb-2 border shadow-sm">
                                            <div class="d-flex align-items-center gap-2 mb-1">
                                                @if (!string.IsNullOrWhiteSpace(res.Photo))
                                                {
                                                    <img src="@res.Photo" alt="@res.Name" class="opacity-75" style="width: 32px; height: 32px; object-fit: cover; border-radius: 50%;" />
                                                }
                                                else
                                                {
                                                    <div class="d-flex align-items-center justify-content-center bg-light text-secondary" 
                                                         style="width: 32px; height: 32px; border-radius: 50%;">
                                                        <i class="bi bi-person fs-5"></i>
                                                    </div>
                                                }
                                                <div class="flex-grow-1 min-w-0">
                                                    <div class="d-flex align-items-center gap-1 flex-wrap">
                                                        <a asp-action="Details" asp-route-id="@res.Id" class="fw-bold text-dark text-decoration-none small">
                                                            @res.Name
                                                        </a>
                                                        <span class="badge bg-light text-dark border" style="font-size: 0.65rem;">@res.Relationship</span>
                                                    </div>
                                                    <div class="text-muted" style="font-size: 0.72rem;">
                                                        যোগদান: @res.CreatedAt.ToString("dd/MM/yy") @(res.LeftAt.HasValue ? $"• ছাড়ার তারিখ: {res.LeftAt.Value.ToString("dd/MM/yy")}" : "")
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="d-flex justify-content-between align-items-center pt-1 border-top" style="font-size: 0.75rem;">
                                                <div>
                                                    @if (!string.IsNullOrWhiteSpace(res.Phone) && res.Phone != "—")
                                                    {
                                                        <a href="tel:@res.Phone" class="text-decoration-none text-dark">
                                                            <i class="bi bi-telephone"></i> @res.Phone
                                                        </a>
                                                    }
                                                </div>
                                                <div class="btn-group btn-group-sm">
                                                    <a asp-action="Details" asp-route-id="@res.Id" class="btn btn-xs btn-light text-primary p-1" title="বিস্তারিত">
                                                        <i class="bi bi-eye"></i>
                                                    </a>
                                                    <button type="button" class="btn btn-xs btn-light text-success p-1" 
                                                            onclick="confirmRestore(@res.Id, '@res.Name', '@group.Room.RoomNumber')" 
                                                            title="পুনর্বহাল">
                                                        <i class="bi bi-arrow-counterclockwise"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-xs btn-light text-danger p-1" 
                                                            onclick="confirmPermanentDelete(@res.Id, '@res.Name')" 
                                                            title="মুছুন">
                                                        <i class="bi bi-trash3-fill"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
}

<!-- MODAL: CONFIRM SINGLE SOFT DELETE -->
<div class="modal fade" id="softDeleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="SoftDelete" method="post">
                <input type="hidden" name="id" id="softDeleteResidentId" />
                <div class="modal-header">
                    <h5 class="modal-title fw-bold text-dark">
                        <i class="bi bi-box-arrow-right text-warning me-2"></i>বাসিন্দা প্রস্থান নিশ্চিতকরণ (সফ্ট ডিলিট)
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-2">
                        আপনি কি নিশ্চিত যে <strong id="softDeleteResidentName" class="text-primary"></strong> আর রুম <span id="softDeleteRoomNumber" class="fw-bold"></span>-এ থাকেন না?
                    </p>
                    <div class="alert alert-warning small mb-0">
                        <i class="bi bi-info-circle me-1"></i>
                        তাকে <strong>সফ্ট ডিলিট</strong> হিসেবে চিহ্নিত করে "প্রাক্তন বাসিন্দা" তালিকায় রাখা হবে। পূর্বের বিল ও রেকর্ড বহাল থাকবে।
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-custom" data-bs-dismiss="modal">বাতিল</button>
                    <button type="submit" class="btn btn-warning fw-bold">
                        <i class="bi bi-check-circle me-1"></i>প্রস্থান নিশ্চিত করুন
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL: CONFIRM VACATE ROOM (SOFT DELETE ALL IN ROOM) -->
<div class="modal fade" id="vacateRoomModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="VacateRoom" method="post">
                <input type="hidden" name="roomId" id="vacateRoomId" />
                <div class="modal-header">
                    <h5 class="modal-title fw-bold text-danger">
                        <i class="bi bi-door-closed text-danger me-2"></i>রুম প্রস্থান ও খালি করুন
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-2">
                        আপনি কি নিশ্চিত যে <strong>রুম <span id="vacateRoomNumber" class="text-primary"></span></strong>-এর সকল বাসিন্দা (<span id="vacateResidentCount" class="fw-bold text-danger"></span> জন) বাসা ছেড়ে চলে গেছেন?
                    </p>
                    <div class="alert alert-danger small mb-0">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i>
                        এই রুমের সকল সক্রিয় বাসিন্দাকে একসাথে <strong>সফ্ট ডিলিট</strong> করে "প্রাক্তন বাসিন্দা" আর্কাইভে রাখা হবে এবং রুমটির স্ট্যাটাস স্বয়ংক্রিয়ভাবে <strong>"খালি (Vacant)"</strong> হয়ে যাবে।
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-custom" data-bs-dismiss="modal">বাতিল</button>
                    <button type="submit" class="btn btn-danger fw-bold">
                        <i class="bi bi-door-closed me-1"></i>হ্যাঁ, রুম খালি ও প্রস্থান সম্পন্ন করুন
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL: CONFIRM PERMANENT DELETE -->
<div class="modal fade" id="permanentDeleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="PermanentDelete" method="post">
                <input type="hidden" name="id" id="permanentDeleteResidentId" />
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-trash3-fill me-2"></i>স্থায়ীভাবে ডিলিট নিশ্চিতকরণ
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-2">
                        আপনি কি নিশ্চিত যে <strong id="permanentDeleteResidentName" class="text-danger"></strong>-এর সকল তথ্য ও আপলোড করা ছবি/NID ডাটাবেজ থেকে <strong>স্থায়ীভাবে মুছে ফেলতে</strong> চান?
                    </p>
                    <div class="alert alert-danger small mb-0">
                        <i class="bi bi-exclamation-octagon-fill me-1"></i>
                        <strong>সতর্কতা:</strong> এটি ডাটাবেজ থেকে চিরতরে মুছে যাবে এবং পরবর্তীতে আর কোনোভাবেই ফিরিয়ে আনা যাবে না!
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-custom" data-bs-dismiss="modal">বাতিল</button>
                    <button type="submit" class="btn btn-danger fw-bold">
                        <i class="bi bi-trash3-fill me-1"></i>স্থায়ীভাবে মুছে ফেলুন
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL: CONFIRM RESTORE -->
