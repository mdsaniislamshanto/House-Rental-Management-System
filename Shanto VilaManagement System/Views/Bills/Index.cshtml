@model IEnumerable<Shanto_VilaManagement_System.Models.MonthlyBill>
@{
    ViewData["Title"] = "মাসিক বিল সমূহ";
    var rooms = ViewBag.Rooms as List<Shanto_VilaManagement_System.Models.Room> ?? new();
    int? selectedYear = ViewBag.SelectedYear;
    int? selectedMonth = ViewBag.SelectedMonth;
    int? selectedRoomId = ViewBag.SelectedRoomId;
    string? selectedStatus = ViewBag.SelectedStatus;

    decimal totalRent = Model.Sum(b => b.RoomRent);
    decimal totalElec = Model.Sum(b => b.ElectricityBill);
    decimal totalBill = Model.Sum(b => b.TotalBill);
    decimal paidBill = Model.Where(b => b.IsPaid).Sum(b => b.TotalBill);
    decimal dueBill = Model.Where(b => !b.IsPaid).Sum(b => b.TotalBill);
}

<!-- Page Header -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h1 class="h3 fw-bold text-dark mb-1">
            <i class="bi bi-receipt text-primary me-2"></i>মাসিক বিল সমূহ
        </h1>
        <p class="text-secondary mb-0 small">সকল রুমের প্রস্তুতকৃত মাসিক ভাড়া ও বিদ্যুৎ বিলের হিসাব এবং বাংলা PDF রশিদ</p>
    </div>

    <div class="d-flex flex-wrap gap-2">
        @if (Model.Any())
        {
            <a asp-action="DownloadAllPdf" 
               asp-route-roomId="@selectedRoomId" 
               asp-route-month="@selectedMonth" 
               asp-route-year="@selectedYear" 
               asp-route-status="@selectedStatus" 
               class="btn btn-danger fw-bold shadow-sm"
               title="সকল বিল একসাথে A4 পেপারে (প্রতি পাতায় ৬টি বিল) ডাউনলোড করুন">
                <i class="bi bi-file-earmark-pdf-fill me-1"></i> সকল বিল একসাথে ডাউনলোড (A4 - ৬টি/পাতা)
            </a>
        }
        <a asp-controller="Electricity" asp-action="Index" class="btn btn-primary-custom">
            <i class="bi bi-speedometer2"></i> নতুন মাসের বিল প্রস্তুত করুন
        </a>
    </div>
</div>

<!-- Filters Card -->
<div class="custom-card mb-4">
    <div class="card-body-custom py-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-3">
                <select name="roomId" class="form-select form-select-sm">
                    <option value="">— সকল রুম —</option>
                    @foreach (var r in rooms)
                    {
                        if (selectedRoomId == r.Id)
                        {
                            <option value="@r.Id" selected>রুম @BanglaHelper.ToBanglaDigits(r.RoomNumber)</option>
                        }
                        else
                        {
                            <option value="@r.Id">রুম @BanglaHelper.ToBanglaDigits(r.RoomNumber)</option>
                        }
                    }
                </select>
            </div>

            <div class="col-md-2">
                <select name="month" class="form-select form-select-sm">
                    <option value="">— সকল মাস —</option>
                    @for (int m = 1; m <= 12; m++)
                    {
                        if (selectedMonth == m)
                        {
                            <option value="@m" selected>@BanglaHelper.GetBanglaMonthName(m)</option>
                        }
                        else
                        {
                            <option value="@m">@BanglaHelper.GetBanglaMonthName(m)</option>
                        }
                    }
                </select>
            </div>

            <div class="col-md-2">
                <select name="year" class="form-select form-select-sm">
                    <option value="">— সকল বছর —</option>
                    @for (int y = DateTime.Now.Year - 2; y <= DateTime.Now.Year + 1; y++)
                    {
                        if (selectedYear == y)
                        {
                            <option value="@y" selected>@BanglaHelper.ToBanglaDigits(y)</option>
                        }
                        else
                        {
                            <option value="@y">@BanglaHelper.ToBanglaDigits(y)</option>
                        }
                    }
                </select>
            </div>

            <div class="col-md-3">
                <select name="status" class="form-select form-select-sm">
                    <option value="All" selected="@(selectedStatus == "All" || string.IsNullOrEmpty(selectedStatus))">সকল অবস্থা (পরিশোধিত, আংশিক ও বকেয়া)</option>
                    <option value="Paid" selected="@(selectedStatus == "Paid")">শুধুমাত্র পরিশোধিত</option>
                    <option value="Partial" selected="@(selectedStatus == "Partial")">শুধুমাত্র আংশিক পরিশোধ</option>
                    <option value="Unpaid" selected="@(selectedStatus == "Unpaid")">শুধুমাত্র বকেয়া</option>
                </select>
            </div>

            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-outline-custom w-100 justify-content-center">
                    <i class="bi bi-funnel"></i> ফিল্টার
                </button>
                <a asp-action="Index" class="btn btn-sm btn-light border" title="রিসেট">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Summary Strip -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="p-3 bg-light rounded-3 border">
            <span class="text-secondary small fw-semibold">ফিল্টারকৃত মোট বিল</span>
            <div class="fs-4 fw-bold text-dark mt-1">@BanglaHelper.ToBanglaCurrency(totalBill)</div>
            <div class="text-muted small">ভাড়া: @BanglaHelper.ToBanglaCurrency(totalRent) | বিদ্যুৎ: @BanglaHelper.ToBanglaCurrency(totalElec)</div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="p-3 rounded-3 border" style="background: #f0fdf4; border-color: #bbf7d0 !important;">
            <span class="text-success small fw-semibold">পরিশোধিত অংশ</span>
            <div class="fs-4 fw-bold text-success mt-1">@BanglaHelper.ToBanglaCurrency(paidBill)</div>
            <div class="text-success small">পরিশোধকৃত মোট টাকা</div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="p-3 rounded-3 border" style="background: #fef2f2; border-color: #fecaca !important;">
            <span class="text-danger small fw-semibold">বকেয়া অংশ</span>
            <div class="fs-4 fw-bold text-danger mt-1">@BanglaHelper.ToBanglaCurrency(dueBill)</div>
            <div class="text-danger small">বর্তমানে পাওনা টাকা</div>
        </div>
    </div>
</div>

<!-- Bills Table -->
<div class="custom-card">
    <div class="card-header-custom d-flex justify-content-between align-items-center">
        <h2 class="card-title-custom">
            <i class="bi bi-receipt text-primary"></i>
            <span>বিলের তালিকা (@BanglaHelper.ToBanglaDigits(Model.Count()) টি)</span>
        </h2>
        @if (Model.Any())
        {
            <a asp-action="DownloadAllPdf" 
               asp-route-roomId="@selectedRoomId" 
               asp-route-month="@selectedMonth" 
               asp-route-year="@selectedYear" 
               asp-route-status="@selectedStatus" 
               class="btn btn-sm btn-outline-danger fw-semibold"
               title="সকল বিল একসাথে A4 পেপারে (প্রতি পাতায় ৬টি বিল) ডাউনলোড করুন">
                <i class="bi bi-printer-fill me-1"></i> এক ক্লিকে সকল বিল ডাউনলোড (A4)
            </a>
        }
    </div>

    <div class="card-body-custom p-0">
        <!-- Desktop Table View -->
        <div class="d-none d-md-block">
            <div class="table-responsive border-0">
                <table class="table-custom">
                    <thead>
                        <tr>
                            <th>রুম</th>
                            <th>ভাড়াটিয়া</th>
                            <th>মাস</th>
                            <th>মিটার (পূর্ব/বর্তমান)</th>
                            <th>ব্যবহৃত ইউনিট</th>
                            <th>বিদ্যুৎ বিল</th>
                            <th>রুম ভাড়া</th>
                            <th>মোট বিল</th>
                            <th>অবস্থা</th>
                            <th class="text-end">রশিদ ও একশন</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="10" class="text-center py-4 text-muted">
                                    নির্বাচিত ফিল্টারে কোনো বিল পাওয়া যায়নি।
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var bill in Model)
                            {
                                <tr>
                                    <td>
                                        <a asp-controller="Rooms" asp-action="Details" asp-route-id="@bill.RoomId" class="fw-bold text-primary text-decoration-none">
                                            রুম @BanglaHelper.ToBanglaDigits(bill.Room?.RoomNumber ?? bill.RoomId.ToString())
                                        </a>
                                    </td>
                                    <td>@bill.TenantName</td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@bill.BillingMonth</span>
                                    </td>
                                    <td class="small">
                                        @BanglaHelper.ToBanglaNumber(bill.PreviousReading, true) / @BanglaHelper.ToBanglaNumber(bill.CurrentReading, true)
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@BanglaHelper.ToBanglaNumber(bill.UsedUnit, true)</span>
                                    </td>
                                    <td class="text-info fw-semibold">
                                        @BanglaHelper.ToBanglaCurrency(bill.ElectricityBill)
                                    </td>
                                    <td>
                                        @BanglaHelper.ToBanglaCurrency(bill.RoomRent)
                                    </td>
                                    <td class="fw-bold text-dark fs-6">
                                        @BanglaHelper.ToBanglaCurrency(bill.TotalBill)
                                        @if (bill.OtherBill > 0)
                                        {
                                            <div class="small text-secondary" style="font-size: 0.75rem;">
                                                (অন্যান্য: @BanglaHelper.ToBanglaCurrency(bill.OtherBill))
                                            </div>
                                        }
                                        @if (bill.PreviousDue > 0)
                                        {
                                            <div class="small text-danger" style="font-size: 0.75rem;" title="পূর্বের বকেয়া সহ">
                                                (বকেয়া: @BanglaHelper.ToBanglaCurrency(bill.PreviousDue))
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        @if (bill.IsPaid)
                                        {
                                            <span class="badge-paid" title="পরিশোধের তারিখ: @BanglaHelper.FormatBanglaDate(bill.PaidDate)">
                                                <i class="bi bi-check-circle-fill"></i> পরিশোধিত
                                            </span>
                                        }
                                        else if (bill.IsPartial)
                                        {
                                            <span class="badge-partial" title="পরিশোধিত: @BanglaHelper.ToBanglaCurrency(bill.EffectivePaidAmount)">
                                                <i class="bi bi-pie-chart-fill"></i> আংশিক পরিশোধ
                                            </span>
                                            <div class="small text-danger fw-bold mt-1" style="font-size: 0.8rem;">
                                                বাকি: @BanglaHelper.ToBanglaCurrency(bill.EffectiveDueAmount)
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="badge-unpaid">
                                                <i class="bi bi-clock-history"></i> বকেয়া
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="DownloadPdf" asp-route-id="@bill.Id" class="btn btn-light text-danger" title="বাংলা PDF ডাউনলোড" target="_blank">
                                                <i class="bi bi-file-earmark-pdf-fill"></i> PDF
                                            </a>
                                            <a asp-action="Print" asp-route-id="@bill.Id" class="btn btn-light text-secondary" title="রশিদ প্রিন্ট" target="_blank">
                                                <i class="bi bi-printer-fill"></i>
                                            </a>
                                            <a asp-action="Details" asp-route-id="@bill.Id" class="btn btn-light text-primary" title="বিস্তারিত">
                                                <i class="bi bi-eye-fill"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Mobile Card View -->
        <div class="d-md-none p-3">
            @if (!Model.Any())
            {
                <div class="text-center py-4 text-muted bg-light rounded-3 border">
                    নির্বাচিত ফিল্টারে কোনো বিল পাওয়া যায়নি।
                </div>
            }
            else
            {
                @foreach (var bill in Model)
                {
                    <div class="mobile-data-card">
                        <!-- Top Row: Room & Payment Status Badge -->
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <a asp-controller="Rooms" asp-action="Details" asp-route-id="@bill.RoomId" class="fw-bold text-primary text-decoration-none fs-6">
                                <i class="bi bi-door-open-fill me-1"></i>রুম @BanglaHelper.ToBanglaDigits(bill.Room?.RoomNumber ?? bill.RoomId.ToString())
                            </a>
                            <div>
                                @if (bill.IsPaid)
                                {
                                    <span class="badge-paid">
                                        <i class="bi bi-check-circle-fill"></i> পরিশোধিত
                                    </span>
                                }
                                else if (bill.IsPartial)
                                {
                                    <span class="badge-partial">
                                        <i class="bi bi-pie-chart-fill"></i> আংশিক পরিশোধ
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-unpaid">
                                        <i class="bi bi-clock-history"></i> বকেয়া
                                    </span>
                                }
                            </div>
                        </div>

                        <!-- Tenant & Billing Month -->
                        <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                            <div>
                                <span class="text-muted small">ভাড়াটিয়া:</span>
                                <span class="fw-semibold text-dark ms-1">@bill.TenantName</span>
                            </div>
                            <span class="badge bg-light text-dark border">
                                <i class="bi bi-calendar3 me-1"></i>@bill.BillingMonth
                            </span>
                        </div>

                        <!-- 3-Column Mini Metrics Grid -->
                        <div class="card-metrics-grid">
                            <div class="metric-box">
                                <div class="metric-label">রুম ভাড়া</div>
                                <div class="metric-value">@BanglaHelper.ToBanglaCurrency(bill.RoomRent)</div>
                            </div>
                            <div class="metric-box">
                                <div class="metric-label">ব্যবহৃত ইউনিট</div>
                                <div class="metric-value text-info">@BanglaHelper.ToBanglaNumber(bill.UsedUnit, true)</div>
                            </div>
                            <div class="metric-box">
                                <div class="metric-label">বিদ্যুৎ বিল</div>
                                <div class="metric-value text-dark">@BanglaHelper.ToBanglaCurrency(bill.ElectricityBill)</div>
                            </div>
                        </div>

                        <!-- Meter Reading small row -->
                        <div class="d-flex justify-content-between align-items-center small text-muted px-1 mb-2">
                            <span>মিটার (পূর্ব/বর্তমান):</span>
                            <span class="fw-semibold text-secondary">
                                @BanglaHelper.ToBanglaNumber(bill.PreviousReading, true) / @BanglaHelper.ToBanglaNumber(bill.CurrentReading, true)
                            </span>
                        </div>

                        <!-- Highlighted Total Bill Row -->
                        <div class="highlight-row">
                            <div>
                                <span class="fw-bold text-dark">মোট বিল:</span>
                                @if (bill.OtherBill > 0)
                                {
                                    <div class="small text-secondary fw-semibold" style="font-size: 0.75rem;">(অন্যান্য: @BanglaHelper.ToBanglaCurrency(bill.OtherBill))</div>
                                }
                                @if (bill.PreviousDue > 0)
                                {
                                    <div class="small text-danger fw-semibold" style="font-size: 0.75rem;">(বকেয়া সহ: @BanglaHelper.ToBanglaCurrency(bill.PreviousDue))</div>
                                }
                                @if (bill.IsPartial)
                                {
                                    <div class="small text-danger fw-bold" style="font-size: 0.78rem;">বাকি: @BanglaHelper.ToBanglaCurrency(bill.EffectiveDueAmount)</div>
                                }
                            </div>
                            <div class="fs-5 fw-bold text-primary">
                                @BanglaHelper.ToBanglaCurrency(bill.TotalBill)
                            </div>
                        </div>

                        <!-- Touch-friendly Action Buttons -->
                        <div class="d-flex gap-2 pt-1">
                            <a asp-action="DownloadPdf" asp-route-id="@bill.Id" class="btn btn-sm btn-outline-danger flex-fill py-2 fw-semibold" target="_blank">
                                <i class="bi bi-file-earmark-pdf-fill me-1"></i> PDF
                            </a>
                            <a asp-action="Print" asp-route-id="@bill.Id" class="btn btn-sm btn-outline-secondary flex-fill py-2 fw-semibold" target="_blank">
                                <i class="bi bi-printer-fill me-1"></i> রশিদ
                            </a>
                            <a asp-action="Details" asp-route-id="@bill.Id" class="btn btn-sm btn-outline-primary flex-fill py-2 fw-semibold">
                                <i class="bi bi-eye-fill me-1"></i> বিস্তারিত
                            </a>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>
