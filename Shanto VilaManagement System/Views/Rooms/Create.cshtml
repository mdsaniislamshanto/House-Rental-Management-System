@model Shanto_VilaManagement_System.Models.Room
@{
    ViewData["Title"] = "নতুন রুম যোগ করুন";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <div class="custom-card">
            <div class="card-header-custom">
                <h2 class="card-title-custom">
                    <i class="bi bi-door-closed-fill text-primary"></i>
                    <span>নতুন রুম যোগ করুন</span>
                </h2>
                <a asp-action="Index" class="btn btn-sm btn-outline-custom">
                    <i class="bi bi-arrow-left"></i> ফিরে যান
                </a>
            </div>

            <div class="card-body-custom">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="RoomNumber" class="form-label fw-semibold"></label>
                        <input asp-for="RoomNumber" class="form-control" placeholder="যেমন: ১০১ বা ২০৫" autofocus />
                        <span asp-validation-for="RoomNumber" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="RoomRent" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light">৳</span>
                            <input asp-for="RoomRent" type="number" step="0.01" class="form-control" placeholder="যেমন: ৮০০০" />
                        </div>
                        <span asp-validation-for="RoomRent" class="text-danger small"></span>
                        <div class="form-text">এই রুমের জন্য নির্ধারিত মাসিক ভাড়া।</div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="OtherBill" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light">৳</span>
                            <input asp-for="OtherBill" type="number" step="0.01" class="form-control" placeholder="যেমন: ১০০ (ফাঁকা রাখলে সাধারণ রেট প্রযোজ্য)" />
                        </div>
                        <span asp-validation-for="OtherBill" class="text-danger small"></span>
                        <div class="form-text">এই রুমের জন্য নির্দিষ্ট অন্যান্য বিল থাকলে লিখুন, অন্যথায় সেটিংসের সাধারণ রেট কার্যকর হবে।</div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="MeterNumber" class="form-label fw-semibold"></label>
                        <input asp-for="MeterNumber" class="form-control" placeholder="যেমন: MTR-101 (ঐচ্ছিক)" />
                        <span asp-validation-for="MeterNumber" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="InitialMeterReading" class="form-label fw-semibold"></label>
                        <input asp-for="InitialMeterReading" type="number" step="0.1" class="form-control" placeholder="যেমন: ১২৫০ (শুরুর মিটার রিডিং)" />
                        <span asp-validation-for="InitialMeterReading" class="text-danger small"></span>
                        <div class="form-text">নতুন রুমের প্রাথমিক রিডিং। প্রথম মাসের বিল গণনায় এটি পূর্বের রিডিং হিসেবে ব্যবহৃত হবে।</div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Status" class="form-label fw-semibold"></label>
                        <select asp-for="Status" class="form-select">
                            <option value="Vacant">খালি (Vacant)</option>
                            <option value="Occupied">ভাড়া দেওয়া (Occupied)</option>
                            <option value="Inactive">নিষ্ক্রিয় (Inactive)</option>
                        </select>
                        <span asp-validation-for="Status" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary-custom flex-grow-1 justify-content-center">
                            <i class="bi bi-check-circle"></i> রুম সংরক্ষণ করুন
                        </button>
                        <a asp-action="Index" class="btn btn-outline-custom">বাতিল</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
