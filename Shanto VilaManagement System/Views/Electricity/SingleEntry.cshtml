@{
    var room = ViewBag.Room as Shanto_VilaManagement_System.Models.Room;
    var year = (int)ViewBag.Year;
    var month = (int)ViewBag.Month;
    var unitPrice = (decimal)ViewBag.UnitPrice;
    var prevReading = (decimal)ViewBag.PreviousReading;
    var prevDue = (decimal)(ViewBag.PreviousDue ?? 0m);
    var otherBill = (decimal)(ViewBag.OtherBill ?? 0m);
    var currReading = ViewBag.CurrentReading as decimal?;
    var existingBill = ViewBag.ExistingBill as Shanto_VilaManagement_System.Models.MonthlyBill;
    ViewData["Title"] = $"রুম {room?.RoomNumber} মিটার রিডিং এন্ট্রি";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <div class="custom-card">
            <div class="card-header-custom">
                <h2 class="card-title-custom">
                    <i class="bi bi-speedometer2 text-primary"></i>
                    <span>রুম @BanglaHelper.ToBanglaDigits(room?.RoomNumber) - মিটার রিডিং</span>
                </h2>
                <a asp-controller="Rooms" asp-action="Details" asp-route-id="@room?.Id" class="btn btn-sm btn-outline-custom">
                    <i class="bi bi-arrow-left"></i> রুমে ফিরে যান
                </a>
            </div>

            <div class="card-body-custom">
                @if (existingBill != null)
                {
                    <div class="alert alert-warning border-warning shadow-sm rounded-3 mb-4 d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <div>
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <span class="badge bg-warning text-dark px-2 py-1">
                                    <i class="bi bi-lock-fill me-1"></i>রিডিং ইতিমধ্যে সংরক্ষিত
                                </span>
                                <span class="fw-bold text-dark">
                                    @BanglaHelper.FormatBillingMonthBangla(year, month) মাসের রিডিং পূর্বে ইনপুট করা হয়েছে।
                                </span>
                            </div>
                            <div class="small text-muted">
                                একই মাসে একাধিকবার নতুন ইনপুট দেওয়া যাবে না (সংরক্ষিত রিডিং: <strong>@BanglaHelper.ToBanglaDigits(currReading)</strong>)। কোনো সংশোধনের প্রয়োজন হলে পাশের 'রিডিং এডিট করুন' বাটনে চাপ দিন।
                            </div>
                        </div>
                        <button type="button" class="btn btn-warning fw-bold text-dark" id="btnToggleEdit" onclick="enableSingleEdit()">
                            <i class="bi bi-pencil-square me-1"></i> রিডিং এডিট করুন
                        </button>
                    </div>
                }

                <div class="p-3 bg-light rounded-3 mb-4 border">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-secondary small">ভাড়াটিয়া:</span>
                        <strong class="text-dark">@(room?.PrimaryTenant?.Name ?? "খালি / অনির্ধারিত")</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-secondary small">রুম ভাড়া:</span>
                        <strong class="text-dark">@BanglaHelper.ToBanglaCurrency(room?.RoomRent ?? 0)</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-secondary small">মিটার নম্বর:</span>
                        <span>@(room?.MeterNumber ?? "—")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-secondary small">অন্যান্য বিল:</span>
                        <strong class="text-dark">@BanglaHelper.ToBanglaCurrency(otherBill)</strong>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-secondary small">বর্তমান ইউনিট মূল্য:</span>
                        <strong class="text-primary">@BanglaHelper.ToBanglaCurrency(unitPrice)</strong>
                    </div>
                </div>

                <form asp-action="SaveSingleEntry" method="post" id="singleReadingForm">
                    <input type="hidden" name="roomId" value="@room?.Id" />
                    <input type="hidden" id="unitPriceInput" value="@unitPrice" />
                    <input type="hidden" id="roomRentInput" value="@(room?.RoomRent ?? 0)" />
                    <input type="hidden" id="otherBillInput" value="@otherBill" />
                    <input type="hidden" name="isEdit" id="isEditInput" value="@(existingBill != null ? "false" : "true")" />

                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold">বিলের মাস</label>
                            <select name="month" class="form-select" onchange="this.form.method='get'; this.form.action='@Url.Action("SingleEntry")'; this.form.submit();">
                                @for (int m = 1; m <= 12; m++)
                                {
                                    if (m == month)
                                    {
                                        <option value="@m" selected>@BanglaHelper.GetBanglaMonthName(m)</option>
                                    }
                                    else
                                    {
                                        <option value="@m">@BanglaHelper.GetBanglaMonthName(m)</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold">বছর</label>
                            <select name="year" class="form-select" onchange="this.form.method='get'; this.form.action='@Url.Action("SingleEntry")'; this.form.submit();">
                                @for (int y = DateTime.Now.Year - 1; y <= DateTime.Now.Year + 1; y++)
                                {
                                    if (y == year)
                                    {
                                        <option value="@y" selected>@BanglaHelper.ToBanglaDigits(y)</option>
                                    }
                                    else
                                    {
                                        <option value="@y">@BanglaHelper.ToBanglaDigits(y)</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">পূর্বের মিটার রিডিং *</label>
                        <input type="number" step="0.1" name="previousReading" id="prevInput" 
                               value="@prevReading" class="form-control fw-bold @(existingBill != null ? "bg-light text-muted" : "")" 
                               required @(existingBill != null ? "readonly" : "") />
                        <div class="form-text small">স্বয়ংক্রিয়ভাবে পূর্ববর্তী রিডিং লোড হয়েছে। মিটার পরিবর্তন বা সমস্যার কারণে প্রয়োজনে এটি ম্যানুয়ালি পরিবর্তন করতে পারেন।</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">বর্তমান মিটার রিডিং *</label>
                        <input type="number" step="0.1" name="currentReading" id="currentReadingInput" 
                               value="@currReading" class="form-control form-control-lg fw-bold @(existingBill != null ? "bg-light text-muted" : "")" 
                               placeholder="বর্তমান রিডিং লিখুন" required 
                               @(existingBill != null ? "readonly" : "autofocus") />
                        <div class="text-danger small mt-1" id="valError" style="display: none;">
                            বর্তমান মিটার রিডিং পূর্বের মিটার রিডিংয়ের চেয়ে কম হতে পারবে না।
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold text-danger">
                            <i class="bi bi-clock-history me-1"></i>আগের মাসের বকেয়া (টাকা)
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-white">৳</span>
                            <input type="number" step="0.01" name="previousDue" id="previousDueInput" 
                                   value="@prevDue" class="form-control fw-bold text-danger @(existingBill != null ? "bg-light text-muted" : "")" 
                                   placeholder="০.০০" @(existingBill != null ? "readonly" : "") />
                        </div>
                        <div class="form-text small">সফটওয়্যার ব্যবহারের পূর্ববর্তী বা আগের বকেয়া থাকলে তা ম্যানুয়ালি লিখুন।</div>
                    </div>

                    <!-- Live Calculation Box -->
                    <div class="card border mb-4 bg-light">
                        <div class="card-header bg-white py-2 small fw-bold text-dark">
                            <i class="bi bi-calculator me-1"></i> লাইভ বিল হিসাব
                        </div>
                        <div class="card-body p-3 small">
                            <div class="d-flex justify-content-between mb-1">
                                <span>ব্যবহৃত ইউনিট:</span>
                                <strong id="calcUsed" class="fs-6">০</strong>
                            </div>
                            <div class="d-flex justify-content-between mb-1">
                                <span>বিদ্যুৎ বিল:</span>
                                <strong id="calcElec" class="text-info fs-6">৳০</strong>
                            </div>
                            <div class="d-flex justify-content-between mb-1">
                                <span>রুম ভাড়া:</span>
                                <strong>@BanglaHelper.ToBanglaCurrency(room?.RoomRent ?? 0)</strong>
                            </div>
                            @if (otherBill > 0)
                            {
                                <div class="d-flex justify-content-between mb-1">
                                    <span>অন্যান্য বিল:</span>
                                    <strong class="text-dark">@BanglaHelper.ToBanglaCurrency(otherBill)</strong>
                                </div>
                            }
                            @if (prevDue > 0)
                            {
                                <div class="d-flex justify-content-between mb-1 text-danger">
                                    <span class="fw-semibold">পূর্বের বকেয়া:</span>
                                    <strong class="fs-6">@BanglaHelper.ToBanglaCurrency(prevDue)</strong>
                                </div>
                            }
                            <hr class="my-2" />
                            <div class="d-flex justify-content-between">
                                <span class="fw-bold fs-6">মোট প্রদেয় বিল:</span>
                                <strong id="calcTotal" class="text-primary fs-5">৳০</strong>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        @if (existingBill != null)
                        {
                            <button type="submit" class="btn btn-warning flex-grow-1 justify-content-center fw-bold" id="submitBtn" style="display: none;">
                                <i class="bi bi-check2-circle me-1"></i> এডিট সংরক্ষণ করুন
                            </button>
                            <div id="readOnlyNotice" class="text-center text-muted small flex-grow-1 py-2 bg-light rounded border">
                                <i class="bi bi-lock-fill me-1 text-warning"></i> রিডিং সংশোধন করতে উপরে <strong>'রিডিং এডিট করুন'</strong> বাটনে চাপ দিন।
                            </div>
                        }
                        else
                        {
                            <button type="submit" class="btn btn-primary-custom flex-grow-1 justify-content-center" id="submitBtn">
                                <i class="bi bi-check-circle"></i> বিল হিসাব করুন ও সংরক্ষণ করুন
                            </button>
                        }
                        <a asp-controller="Rooms" asp-action="Details" asp-route-id="@room?.Id" class="btn btn-outline-custom">বাতিল</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const prevInput = document.getElementById('prevInput');
        const unitPrice = parseFloat(document.getElementById('unitPriceInput').value) || 12;
        const rent = parseFloat(document.getElementById('roomRentInput').value) || 0;
        const otherBill = parseFloat(document.getElementById('otherBillInput')?.value) || 0;
        const prevDue = @prevDue;

        const currInput = document.getElementById('currentReadingInput');
        const previousDueInput = document.getElementById('previousDueInput');
        const valError = document.getElementById('valError');
        const submitBtn = document.getElementById('submitBtn');
        const calcUsed = document.getElementById('calcUsed');
        const calcElec = document.getElementById('calcElec');
        const calcTotal = document.getElementById('calcTotal');

        const banglaDigits = ['০', '১', '২', '৩', '৪', '৫', '৬', '৭', '৮', '৯'];
        function toBanglaDigits(num) {
            return num.toString().replace(/\d/g, d => banglaDigits[d]);
        }

        function updateCalc() {
            const prev = parseFloat(prevInput.value) || 0;
            const currentDue = parseFloat(previousDueInput ? previousDueInput.value : 0) || 0;
            const val = currInput.value.trim();
            if (val === '') {
                valError.style.display = 'none';
                submitBtn.disabled = false;
                calcUsed.textContent = '০';
                calcElec.textContent = '৳০';
                calcTotal.textContent = '৳' + toBanglaDigits(Math.round(rent + otherBill + currentDue).toLocaleString('en-US'));
                return;
            }

            const curr = parseFloat(val);
            if (curr < prev) {
                valError.style.display = 'block';
                submitBtn.disabled = true;
                calcUsed.textContent = '০';
                calcElec.textContent = '৳০';
                calcTotal.textContent = '৳' + toBanglaDigits(Math.round(rent + otherBill + currentDue).toLocaleString('en-US'));
            } else {
                valError.style.display = 'none';
                submitBtn.disabled = false;

                const used = curr - prev;
                const elec = used * unitPrice;
                const total = rent + elec + otherBill + currentDue;

                calcUsed.textContent = toBanglaDigits(used % 1 === 0 ? used : used.toFixed(1));
                calcElec.textContent = '৳' + toBanglaDigits(Math.round(elec).toLocaleString('en-US'));
                calcTotal.textContent = '৳' + toBanglaDigits(Math.round(total).toLocaleString('en-US'));
            }
        }

        currInput.addEventListener('input', updateCalc);
        prevInput.addEventListener('input', updateCalc);
        if (previousDueInput) previousDueInput.addEventListener('input', updateCalc);
        updateCalc();

        function enableSingleEdit() {
            const isReadonly = currInput.hasAttribute('readonly');
            const isEditInput = document.getElementById('isEditInput');
            const toggleBtn = document.getElementById('btnToggleEdit');
            const notice = document.getElementById('readOnlyNotice');

            if (isReadonly) {
                // Unlock for editing
                currInput.removeAttribute('readonly');
                prevInput.removeAttribute('readonly');
                if (previousDueInput) previousDueInput.removeAttribute('readonly');
                currInput.classList.remove('bg-light', 'text-muted');
                currInput.classList.add('border-warning', 'bg-warning-subtle');
                prevInput.classList.remove('bg-light', 'text-muted');
                if (previousDueInput) previousDueInput.classList.remove('bg-light', 'text-muted');
                isEditInput.value = "true";
                if (notice) notice.style.display = 'none';
                if (submitBtn) {
                    submitBtn.style.display = 'inline-flex';
                    submitBtn.disabled = false;
                }
                if (toggleBtn) {
                    toggleBtn.innerHTML = '<i class="bi bi-x-circle me-1"></i> এডিট বাতিল';
                    toggleBtn.className = 'btn btn-outline-secondary';
                }
                currInput.focus();
            } else {
                // Lock back (cancel editing)
                currInput.setAttribute('readonly', 'readonly');
                prevInput.setAttribute('readonly', 'readonly');
                if (previousDueInput) previousDueInput.setAttribute('readonly', 'readonly');
                currInput.classList.add('bg-light', 'text-muted');
                currInput.classList.remove('border-warning', 'bg-warning-subtle');
                prevInput.classList.add('bg-light', 'text-muted');
                if (previousDueInput) previousDueInput.classList.add('bg-light', 'text-muted');
                isEditInput.value = "false";
                if (notice) notice.style.display = 'block';
                if (submitBtn) {
                    submitBtn.style.display = 'none';
                    submitBtn.disabled = true;
                }
                if (toggleBtn) {
                    toggleBtn.innerHTML = '<i class="bi bi-pencil-square me-1"></i> রিডিং এডিট করুন';
                    toggleBtn.className = 'btn btn-warning fw-bold text-dark';
                }
            }
        }

        let isSingleSubmitting = false;
        document.getElementById('singleReadingForm').addEventListener('submit', function (e) {
            if (isSingleSubmitting) {
                e.preventDefault();
                return false;
            }
            isSingleSubmitting = true;
            if (submitBtn) {
                submitBtn.classList.add('disabled');
                submitBtn.style.pointerEvents = 'none';
                submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>সংরক্ষণ হচ্ছে...';
            }
        });
    </script>
}
